import { createServer } from 'node:http';
import fs from 'node:fs/promises';
import path from 'node:path';
import crypto from 'node:crypto';
import { spawn } from 'node:child_process';
import { once } from 'node:events';
import { fileURLToPath } from 'node:url';
const root=path.dirname(fileURLToPath(import.meta.url));
const manifest=JSON.parse(await fs.readFile(path.join(root,'manifest.json'),'utf8'));
for(const file of manifest.files){const bytes=await fs.readFile(path.join(root,file.path));const actual=crypto.createHash('sha256').update(bytes).digest('hex');if(actual!==file.sha256)throw Error('Transferred file mismatch: '+file.path);}
console.log(JSON.stringify({transferred_files_verified:manifest.files.length,receiving_commit:manifest.receiving_commit}));
const types={'.html':'text/html','.js':'text/javascript','.css':'text/css','.svg':'image/svg+xml'};
const server=createServer(async(req,res)=>{try{let name=decodeURIComponent(new URL(req.url,'http://127.0.0.1').pathname);if(name.endsWith('/'))name+='index.html';const file=path.resolve(root,'.'+name);if(!file.startsWith(root+path.sep)||!['/candidate/','/baseline/','/combined/'].some(prefix=>name.startsWith(prefix))){res.writeHead(404).end();return;}const bytes=await fs.readFile(file);res.writeHead(200,{'Content-Type':types[path.extname(file)]||'application/octet-stream','Cache-Control':'no-store'});res.end(bytes);}catch{res.writeHead(404).end();}});
server.listen(0,'127.0.0.1');await once(server,'listening');
const port=server.address().port;
const env={...process.env,RETURNBY_PLAYWRIGHT:'/home/jacob/.cache/returnby-backup-8b336fefde84/node_modules/playwright/index.mjs',RETURNBY_CHROME:'/snap/bin/chromium',RETURNBY_DOWNLOAD_DIR:'/home/jacob/snap/chromium/common/returnby-edit-965d2e86e979',TMPDIR:'/home/jacob/snap/chromium/common/returnby-edit-965d2e86e979/tmp'};
try {
 for(const [name,script,route,baseline] of [['final-editor','check_edit_browser.mjs','candidate',true],['combined-editor','check_edit_browser.mjs','combined',false],['combined-backup','check_backup_browser.mjs','combined',false],['edit-backup-handoff','check_edit_backup_browser.mjs','combined',false]]){
 console.log('BEGIN '+name);
 const child=spawn(process.execPath,[path.join(root,script)],{cwd:root,stdio:'inherit',env:{...env,RETURNBY_BASE_URL:`http://127.0.0.1:${port}/${route}/`,...(baseline?{RETURNBY_BASELINE_URL:`http://127.0.0.1:${port}/baseline/`}:{}),RETURNBY_CAPTURE_DIR:path.join(root,'captures',name)}});
 const [code,signal]=await once(child,'exit');if(code!==0||signal){process.exitCode=code??1;break;}console.log('PASS '+name);
 }
}finally{server.closeAllConnections();server.close();}
