+.paper-symbol span{display:block;font:bold 17px Georgia,serif;text-align:left;margin-bottom:11px}.paper-symbol i{display:block;border-bottom:1px solid #c2cbb5;margin:7px 0}
+.empty-preview h3{font:normal 28px/1.25 Georgia,serif;margin:0 0 15px;color:#4e6543}.empty-preview>p{max-width:300px;font-size:12px;line-height:1.8;color:#788368;margin:0}
+.empty-preview ul{list-style:none;padding:20px 0 0;margin:20px 0 0;border-top:1px solid #c7d0ba;display:grid;gap:12px;font-size:10px;color:#71825e}
+.empty-preview li::before{content:"✓";display:inline-block;margin-right:10px;color:#748d5e}
+.trip-notice{font-size:12px;line-height:1.65;border-left:3px solid #557c42;background:#e2ead7;padding:13px 16px;margin:0 0 15px;overflow-wrap:anywhere}
+.trip-notice.error{background:#f4e4d8;border-color:#985630;color:#783f25}
+#checklist-preview{box-shadow:0 10px 25px #20351b08}
+.download-panel{display:grid;grid-template-columns:1.1fr 1fr;gap:18px;align-items:center;border-top:1px solid var(--line);margin-top:22px;padding-top:20px}
