+.primary-button:not(:disabled):hover{background:#375f3e}.primary-button span{font-size:18px;font-weight:400}
+.privacy-note{font-size:10px;line-height:1.8;color:#738066;border-top:1px solid var(--line);padding-top:18px;margin:23px 0 0}
