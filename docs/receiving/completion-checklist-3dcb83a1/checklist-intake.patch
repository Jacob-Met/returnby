+.checklist-footer{border-top:1px solid var(--line);margin-top:44px;padding:23px 0 32px;display:flex;gap:18px;align-items:baseline;color:#798269}
+.checklist-footer strong{font-size:9px;letter-spacing:.09em;white-space:nowrap}.checklist-footer p{font-size:10px;line-height:1.7;margin:0}
+.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;padding:0}
+@media(max-width:1050px){.checklist-shell{padding:0 30px}.workspace{gap:20px;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr)}.planner{padding:22px}.download-panel{grid-template-columns:1fr;gap:10px}.flow-note{flex-basis:225px}.checklist-footer{display:block}.checklist-footer p{margin-top:8px}}
+@media(max-width:820px){.workspace{grid-template-columns:1fr}.checklist-hero{gap:25px;align-items:flex-start}.flow-note{display:none}.planner{padding:25px}.preview-panel{margin-top:5px}.empty-preview{min-height:380px;padding:40px 25px}.download-panel{grid-template-columns:1fr 1fr}.checklist-shell{padding:0 24px}h1{font-size:44px}.hero-copy{max-width:550px}.back-link{margin-bottom:25px}}
+@media(max-width:480px){.checklist-shell{padding:0 18px}.checklist-topbar{padding:21px 0}.brand strong{font-size:12px}.brand small{font-size:7px}.local-chip{font-size:7px;letter-spacing:.02em;gap:5px}.local-chip i{width:5px;height:5px}.checklist-hero{padding:25px 0 28px}h1{font-size:40px;letter-spacing:-1.3px}.hero-copy{font-size:13px}.planner{padding:22px 18px}.section-heading h2,.preview-top h2{font-size:24px}.preview-top{padding-top:7px}.paper-tag{font-size:7px}.download-panel{grid-template-columns:1fr}.checklist-footer{margin-top:30px}}
+@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
+@media print{.checklist-topbar,.checklist-hero,.planner,.preview-top,.trip-notice,.download-panel,.checklist-footer,.empty-preview{display:none!important}.checklist-shell{padding:0;max-width:none}.workspace{display:block}.preview-panel{margin:0}#checklist-preview{box-shadow:none}}
