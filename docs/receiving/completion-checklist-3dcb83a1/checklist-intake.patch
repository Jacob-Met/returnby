+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f2efe5">
+  <meta name="description" content="Choose saved ReturnBy orders and prepare a printable checklist for your next return trip.">
+  <link rel="icon" type="image/svg+xml" href="./favicon.svg">
+  <title>ReturnBy · Return-trip checklist</title>
+</head>
+<body>
+<div class="checklist-shell">
