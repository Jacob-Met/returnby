diff --git a/tests/completion-checklist-independent.test.ts b/tests/completion-checklist-independent.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/completion-checklist-independent.test.ts
@@ -0,0 +1,48 @@
+import { describe, it, expect } from 'vitest';
+import { parseSavedOrders, createChecklist, assertSnapshotCurrent, buildChecklistHtml } from '../src/trip-checklist';
+import { planCompletion, isCompleted } from '../src/completion';
+import type { Order } from '../src/store';
+
+const a:Order={id:'receive-open-a',merchant:'Synthetic <Cedar> 海',orderNo:'A-7\n"reviewed"',total:'EUR 29,50 & JPY 300',orderDate:'2026-09-20',windowDays:30,windowSource:'user',createdAt:'2026-10-01T01:02:03.000Z'};
+const b:Order={...a,id:'receive-open-b',merchant:'Synthetic Birch',orderNo:'B-8',windowSource:'policy'};
+const complete=(orders:Order[],id:string)=>planCompletion(orders,orders.find(x=>x.id===id),'complete',new Date('2026-10-08T19:00:00.000Z')).next;
+describe('current completion producer into printable trip consumer',()=>{
+ it('retains completion identity and refuses selecting a finished return',()=>{
+  const current=complete([a,b],a.id), snap=parseSavedOrders(JSON.stringify(current));
+  expect(snap.orders.find(x=>x.id===a.id)?.completedAt).toBe(current[0].completedAt);
+  expect(()=>createChecklist(snap,[a.id],'2026-10-10','2026-10-08')).toThrow(/completed|reopen/i);
+ });
+ it('refuses invalid completion markers rather than projecting them away',()=>{
+  for(const marker of [null,false,0,'','unknown','2026-02-30T12:00:00Z']){
+   expect(()=>parseSavedOrders(JSON.stringify([{...a,completedAt:marker}]))).toThrow();
+  }
+ });
+ it('admits the complete source before offering an ordinary earlier record',()=>{
+  expect(()=>parseSavedOrders(JSON.stringify([a,{...b,completedAt:'invalid'}]))).toThrow();
+ });
+ it('keeps ordinary selected fields, rendering and stored bytes unchanged beside an unrelated completed order',()=>{
+  const current=complete([a,b],b.id), raw=JSON.stringify(current);
+  const ordinary=createChecklist(parseSavedOrders(JSON.stringify([a])),[a.id],'2026-10-10','2026-10-08');
+  const mixed=createChecklist(parseSavedOrders(raw),[a.id],'2026-10-10','2026-10-08');
+  expect(mixed).toEqual(ordinary); expect(buildChecklistHtml(mixed)).toBe(buildChecklistHtml(ordinary));
+  expect(buildChecklistHtml(mixed)).toContain('Synthetic &lt;Cedar&gt; 海');
+  expect(JSON.stringify(current)).toBe(raw);
+ });
+ it('already refuses a selection completed after its snapshot was prepared',()=>{
+  const original=JSON.stringify([a,b]),snap=parseSavedOrders(original);
+  createChecklist(snap,[a.id],'2026-10-10','2026-10-08');
+  expect(()=>assertSnapshotCurrent(snap,{getItem:()=>JSON.stringify(complete([a,b],a.id))})).toThrow(/changed|refresh/i);
+  expect(snap.raw).toBe(original);
+ });
+ it('reopens through the actual owner transition with original identity and exact printable output',()=>{
+  const current=complete([a,b],a.id);
+  const reopened=planCompletion(current,current[0],'reopen').next;
+  expect(reopened).toEqual([a,b]); expect(isCompleted(reopened[0])).toBe(false);
+  expect(buildChecklistHtml(createChecklist(parseSavedOrders(JSON.stringify(reopened)),[a.id],'2026-10-10','2026-10-08')))
+   .toBe(buildChecklistHtml(createChecklist(parseSavedOrders(JSON.stringify([a,b])),[a.id],'2026-10-10','2026-10-08')));
+ });
+ it('cannot produce an active trip from an all-completed list',()=>{
+  const current=complete(complete([a,b],a.id),b.id),snap=parseSavedOrders(JSON.stringify(current));
+  expect(()=>createChecklist(snap,[a.id,b.id],'2026-10-10','2026-10-08')).toThrow(/completed|reopen/i);
+ });
+});
